<?php

use Krystal\Widget\GridView\GridViewWidget;
use Krystal\Form\Element;
use Cms\View\Icon;

?>

<div class="btn-toolbar mb-3">
    <?php $this->loadPartial('menu', [
        'items' => [
            'Subscribe:Admin:Send@indexAction' => 'New bulk-sending'
        ],
        'actions' => [
            'data' => $subscribers,
            'save' => 'Subscribe:Admin:Subscriber@tweakAction',
            'delete' => 'Subscribe:Admin:Subscriber@deleteAction'
        ]
    ]); ?>
</div>

<div class="card">
    <?php $this->loadPartial('items-per-page', ['caption' => 'Subscribers']); ?>

    <form>
        <?= $this->widget(new GridViewWidget($subscribers, [
            'batch' => true,
            'pk' => 'id',
            'tableClass' => 'table table-hover table-bordered table-striped',
            'columns' => [
                [
                    'column' => 'id',
                    'label' => '#'
                ],

                [
                    'column' => 'name'
                ],

                [
                    'column' => 'email'
                ],

                [
                    'column' => 'active',
                    'value' => function($subscriber){
                        return Element::checkbox(sprintf('active[%s]', $subscriber->getId()), $subscriber->getActive(), ['class' => 'form-check-input']);
                    }
                ],

                [
                    'column' => 'datetime',
                    'label' => 'Date and time'
                ]
            ],

            'actions' => [
                function($subscriber){
                    return Icon::edit(
                        $this->url('Subscribe:Admin:Subscriber@editAction', $subscriber->getId()),
                        $this->translate('Edit this subscriber')
                    );
                },

                function($subscriber){
                    return Icon::remove(
                        $this->url('Subscribe:Admin:Subscriber@deleteAction', $subscriber->getId()),
                        $this->translate('Remove this subscriber')
                    );
                }
            ]
        ])); ?>

        <?php if (empty($subscribers)): ?>
        <h2 class="text-center text-muted"><i class="bi bi-x"></i> <?= $this->translate('You have no subscribers'); ?></h2>
        <?php endif; ?>

    </form>

    <?php $this->loadPartial('paginator'); ?>
</div>